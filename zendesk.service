[Unit]
Description=ZenDesk wellness launcher
After=multi-user.target

[Service]
Type=simple
User=cjl
WorkingDirectory=/home/cjl/zendesk
ExecStart=/usr/bin/python3 /home/cjl/zendesk/zendesk.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
